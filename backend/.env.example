# Backend Environment Variables (Render / Local)
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=capstone-super-secret-key-csa5106-change-in-production
PORT=5000

# Database
# Local SQLite: sqlite:///instance/crypto_capstone.db
# Production PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///instance/crypto_capstone.db

# CORS (Frontend Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Storage
STORAGE_TYPE=local
STORAGE_DIR=storage

# Biometric & Liveness Parameters
EYE_SIMILARITY_THRESHOLD=0.90
BLINK_EAR_CLOSE_THRESHOLD=0.17
BLINK_EAR_OPEN_THRESHOLD=0.22

# Security & Attempt Limits
MAX_PASSWORD_ATTEMPTS=5
MAX_EYE_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15
SESSION_EXPIRY_MINUTES=60
KEY_REVEAL_TIMEOUT_SECONDS=30
