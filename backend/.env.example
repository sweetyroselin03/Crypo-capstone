# ==============================================================================
# Flask Backend Environment Variables (.env.example)
# Capstone Project: CSA5106 - Cryptography and Network Security
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY (REQUIRED ON RENDER)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and internal security operations.
# On Render: Click 'Generate' or provide a random 32+ character string.
SECRET_KEY=change-this-to-a-cryptographically-random-string-in-production

# Environment mode: 'production' for live Render deployment, 'development' locally.
FLASK_ENV=production

# Debug mode: Always set to '0' (disabled) in production to prevent traceback leaks.
FLASK_DEBUG=0

# Web server port (Render injects $PORT automatically, defaults to 5000 locally).
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Database connection string.
# Local development: defaults to SQLite (sqlite:///instance/crypto_capstone.db)
# Render production: Set to your Render PostgreSQL Internal Connection String:
# Example: postgresql://capstone_user:password123@dpg-xxxxxx-a.oregon-postgres.render.com/capstone_db
DATABASE_URL=sqlite:///instance/crypto_capstone.db

# ------------------------------------------------------------------------------
# 3. CORS CONFIGURATION (REQUIRED FOR VERCEL FRONTEND)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins that can call the API.
# In production, replace with your exact Vercel frontend URL.
# Example: https://crypto-capstone.vercel.app
CORS_ORIGINS=http://localhost:5173,https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# 4. PERSISTENT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Storage mode: 'local' for filesystem storage, or 's3' for object storage.
STORAGE_TYPE=local

# Local directory where encrypted payloads (.enc) are stored.
# On Render: use a persistent disk or project path: /opt/render/project/src/storage
STORAGE_DIR=storage

# Optional S3 bucket name if using AWS S3 / Cloudflare R2 object storage.
S3_BUCKET=my-encrypted-files-bucket

# Maximum upload file size limit in bytes (Default: 16777216 = 16 MB).
MAX_UPLOAD_SIZE_BYTES=16777216

# ------------------------------------------------------------------------------
# 5. BIOMETRICS & LIVENESS DETECTION (SAFE DEFAULTS)
# ------------------------------------------------------------------------------
# Cosine similarity threshold for 512-dim LBP periocular vector matching.
# (Default: 0.90 demo setting)
EYE_SIMILARITY_THRESHOLD=0.90

# Eye Aspect Ratio (EAR) thresholds for blink liveness detection:
# Eye closure threshold (eyes closed if EAR <= 0.17)
BLINK_EAR_CLOSE_THRESHOLD=0.17
# Eye reopening threshold (eyes reopened if EAR >= 0.22)
BLINK_EAR_OPEN_THRESHOLD=0.22

# ------------------------------------------------------------------------------
# 6. SECURITY LOCKOUTS & TIMEOUTS (SAFE DEFAULTS)
# ------------------------------------------------------------------------------
# Maximum failed password attempts before triggering a 15-minute lockout (Default: 5).
MAX_PASSWORD_ATTEMPTS=5

# Maximum failed eye-scan verification attempts before lockout (Default: 3).
MAX_EYE_ATTEMPTS=3

# Duration of brute-force lockout in minutes (Default: 15).
LOCKOUT_DURATION_MINUTES=15

# Session validity duration in minutes before expiration (Default: 60).
SESSION_EXPIRY_MINUTES=60

# Duration in seconds for temporary masked key reveal screen (Default: 30).
KEY_REVEAL_TIMEOUT_SECONDS=30
