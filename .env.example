# ==============================================================================
# Master Environment Variables Reference (.env.example)
# Capstone: QR Code Secure Key Exchange with Biometric Eye-Scan Authentication
# ==============================================================================

# ==============================================================================
# FRONTEND CONFIGURATION (Vercel)
# ==============================================================================
# Set this in your Vercel Project Settings > Environment Variables:
# Points the React application to your live Render Flask backend API URL.
VITE_API_BASE_URL=https://crypto-capstone-api.onrender.com/api


# ==============================================================================
# BACKEND CONFIGURATION (Render Web Service)
# ==============================================================================
# Set these in your Render Web Service > Environment tab:

# 1. CORE APPLICATION & SECURITY (REQUIRED)
SECRET_KEY=generate-a-strong-32-character-random-key-in-render
FLASK_ENV=production
FLASK_DEBUG=0
# Note: PORT is automatically assigned and injected by Render at runtime ($PORT)

# 2. DATABASE CONFIGURATION
# Local: sqlite:///instance/crypto_capstone.db
# Render PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///instance/crypto_capstone.db

# 3. CORS PERMISSIONS (REQUIRED)
# Must include your live Vercel domain to permit cross-origin API calls.
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# 4. STORAGE CONFIGURATION
STORAGE_TYPE=local
STORAGE_DIR=/opt/render/project/src/storage
MAX_UPLOAD_SIZE_BYTES=16777216
# S3_BUCKET=optional-s3-bucket-name

# 5. BIOMETRICS & LIVENESS THRESHOLDS (OPTIONAL - SAFE DEFAULTS PROVIDED)
EYE_SIMILARITY_THRESHOLD=0.90
BLINK_EAR_CLOSE_THRESHOLD=0.17
BLINK_EAR_OPEN_THRESHOLD=0.22

# 6. SECURITY LOCKOUTS & TIMEOUTS (OPTIONAL - SAFE DEFAULTS PROVIDED)
MAX_PASSWORD_ATTEMPTS=5
MAX_EYE_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15
SESSION_EXPIRY_MINUTES=60
KEY_REVEAL_TIMEOUT_SECONDS=30
