# Root Environment Variables Overview

# 1. Frontend (Vercel)
# In production, set to your live Render backend URL
VITE_API_BASE_URL=https://crypto-capstone-api.onrender.com/api

# 2. Backend (Render)
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-to-a-cryptographically-random-string-in-production
DATABASE_URL=postgresql://username:password@hostname:5432/dbname
CORS_ORIGINS=https://your-frontend.vercel.app
STORAGE_TYPE=local
STORAGE_DIR=/opt/render/project/src/storage
EYE_SIMILARITY_THRESHOLD=0.90
BLINK_EAR_CLOSE_THRESHOLD=0.17
BLINK_EAR_OPEN_THRESHOLD=0.22
MAX_PASSWORD_ATTEMPTS=5
MAX_EYE_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15
